# Copy this file to `.env.local` and fill in your API keys and endpoints.

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
CARTESIA_API_KEY=your_cartesia_api_key_here
GEMINI_KEY=your_gemini_text_key_here
GEMINI_API_KEY=your_gemini_image_key_here
MIMO_KEY=your_mimo_api_key_here
DEEPSEEK_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI Image + Voice Studio
THREADS_APP_ID=your_threads_app_id_here
THREADS_APP_SECRET=your_threads_app_secret_here
THREADS_API_BASE=https://graph.threads.net
# Optional: set this only if you want to force a fixed callback URL instead of using the current host.
# THREADS_REDIRECT_URI=https://your-ngrok-or-production-domain/api/threads/oauth/callback
# Optional: override the default callback path when THREADS_REDIRECT_URI is not set.
# THREADS_REDIRECT_PATH=/api/threads/oauth/callback

# YouTube publishing / OAuth configuration.
# Client ID and secret are shared across channels. Per-channel refresh tokens are encrypted in the DB.
YOUTUBE_CLIENT_ID=your_google_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret_here
YOUTUBE_PROFILE_MASTER_KEY=replace_with_a_long_random_secret
# Optional: set this to your ngrok or production callback URL and also register it in Google Cloud Console.
# YOUTUBE_REDIRECT_URI=https://your-ngrok-or-production-domain/api/youtube/oauth/callback
# Optional: override the default callback path when YOUTUBE_REDIRECT_URI is not set.
# YOUTUBE_REDIRECT_PATH=/api/youtube/oauth/callback
# Optional: override scopes. Upload requires youtube.upload; metadata writes use youtube.force-ssl.
# YOUTUBE_SCOPE=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.force-ssl

# A2E (e2e) API configuration
A2E_API_KEY=your_a2e_api_key_here
A2E_API_BASE=https://video.a2e.ai/api/v1

# Fal.ai API configuration
FAL_KEY=your_fal_api_key_here

# Optional self-host inference server base URL used by the new Self-Host vendor.
SELF_HOST_INFERENCE_BASE=http://localhost:8000

DATABASE_PATH=./data/database.sqlite
